{
  "name": "preflight-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "types": "json2ts -i schema.json -o src/screening.d.ts",
    "check": "tsc --noEmit",
    "format:check": "prettier --check src tests *.config.ts *.json index.html",
    "format": "prettier --write src tests *.config.ts *.json index.html",
    "build": "npm run types && npm run check && vite build",
    "test": "vitest run src",
    "test:browser": "playwright test",
    "install:browser": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
