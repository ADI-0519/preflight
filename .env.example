# Meta Model API key (https://api.meta.ai/v1)
META_API_KEY=

# Optional P43 development-only triage via Baseten synchronous Model APIs.
# Keep the real key in your local environment or ignored .env, never in Git.
BASETEN_API_KEY=
GLIMMER_MODEL=meta-models/muse-spark-open-1026

# Optional sign-in with Firebase Authentication (Google, or email and password).
# Leave FIREBASE_PROJECT_ID empty to run the workspace open, as it does locally.
# The four Firebase values come from the project's Web app settings; Firebase treats them as public.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
# Signs the session cookie; any long random string. Without it, sessions end when the server restarts.
PREFLIGHT_SESSION_SECRET=
# Who may sign in: comma-separated emails, or @domain for a whole domain. Empty lets any account in.
PREFLIGHT_ALLOWED_EMAILS=
# Every sign-in waits for a 6-digit code emailed over SMTP. For Gmail: host smtp.gmail.com, port 587,
# your address as user, and an App Password (Google Account > Security > App passwords) as password.
PREFLIGHT_SMTP_HOST=
PREFLIGHT_SMTP_PORT=587
PREFLIGHT_SMTP_USER=
PREFLIGHT_SMTP_PASSWORD=
PREFLIGHT_MAIL_FROM=
# Local only: with no SMTP host, set to 1 to write sign-in codes to the server log instead of emailing them.
PREFLIGHT_DEV_CODES=

# Deployment only: public host names the service answers on, comma-separated (deploy/cloud-run.sh sets it).
PREFLIGHT_ALLOWED_HOSTS=
