# PreFlight settings template. Copy this file to .env (git-ignored) and fill in the values:
#   cp .env.example .env
# Never commit .env, and never put real values in this file, docs, issues or chat.
# README.md > "Settings (.env)" explains each variable and where its value comes from.

# --- Required for live screening -------------------------------------------------------------
# Meta Model API key (https://api.meta.ai/v1). Not needed for --replay runs or the test suite.
META_API_KEY=

# --- Sign-in (optional locally; required on a deployed service) ------------------------------
# Leave FIREBASE_PROJECT_ID empty to run the workspace open, as it does locally.
# The four Firebase values come from the team's Firebase project > Project settings > Your apps > Web app.
# Firebase treats them as public, but keep them in .env with the rest.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
# Signs the session cookie: any long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without it, sessions end when the server restarts.
PREFLIGHT_SESSION_SECRET=
# Who may sign in: comma-separated emails, or @domain for a whole domain. Empty lets any account in.
PREFLIGHT_ALLOWED_EMAILS=

# --- Sign-in code email (needed when sign-in is on) ------------------------------------------
# Every sign-in waits for a 6-digit code emailed over SMTP. For Gmail: host smtp.gmail.com, port 587,
# your address as user, and an App Password (Google Account > Security > App passwords) as password.
PREFLIGHT_SMTP_HOST=
PREFLIGHT_SMTP_PORT=587
PREFLIGHT_SMTP_USER=
PREFLIGHT_SMTP_PASSWORD=
# Sender address; defaults to PREFLIGHT_SMTP_USER.
PREFLIGHT_MAIL_FROM=
# Local only: with no SMTP host, set to 1 to write sign-in codes to the server log instead of emailing them.
PREFLIGHT_DEV_CODES=

# --- Optional ----------------------------------------------------------------------------------
# Public demo limits (P67): "on" applies per-visitor limits, "replay" only runs the preloaded demos.
PREFLIGHT_PUBLIC_MODE=
# P43 development-only triage through Baseten's Model APIs.
BASETEN_API_KEY=
GLIMMER_MODEL=meta-models/muse-spark-open-1026

# --- Deployment only ---------------------------------------------------------------------------
# Public host names the service answers on, comma-separated; deploy/cloud-run.sh sets it on Cloud Run.
PREFLIGHT_ALLOWED_HOSTS=
